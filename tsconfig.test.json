{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "rootDir": ".",
    "types": ["node", "vitest/globals", "vite/client"],
    "jsx": "react-jsx",
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "apps/*/src/**/*.ts",
    "apps/*/src/**/*.tsx",
    "apps/*/test/**/*.ts",
    "apps/*/test/**/*.tsx",
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "services/*/src/**/*.ts",
    "services/*/test/**/*.ts"
  ]
}
